# Generisani podaci — reprodukuju se iz generator/generisi.js za ~16 s.
# Fiksno seme daje identican rezultat, pa nema razloga drzati ih u istoriji.
#   node generisi.js --korak 0.5 --izlaz ./podaci_05km
generator/podaci_*/*
generator/kepler_*.csv
!generator/podaci_*/meta.json
!generator/podaci_*/uzorak_long.csv

# Node
node_modules/

# Word privremeni fajlovi
~$*

# Sklopljeni prikazi — prave se iz sablona, aplikacije i bandla
prototip/hexagon-layer.html
prototip/hexagon-layer-cdn.html
prototip/LICENSES.txt

# Bandl preuzet za ugradnju
prototip/maplibre-gl.js
prototip/maplibre-gl.css

# Folder za predaju — ceo ga pravi napravi-hex.js iz pracenih izvora.
# Nista se odavde ne cuva u istoriji: slobodno se brise i pravi ponovo.
# Izvor pisanog teksta je prototip/procitaj-isporuka.md.
isporuka/

# Drzi se samo lokalno, van repozitorijuma.
prototip/UPUTSTVO.md
prototip/cenovna-povrsina.html

# deck.gl tarbol i raspakovan paket, preuzimaju se sa npm-a
prototip/deck.gl-*.tgz
prototip/package/
